rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & ROLE-BASED ACCESS CONTROL (RBAC)
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
            ? getUserData().role 
            : 'kasir');
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin' || request.auth.token.admin == true);
    }

    function isSupervisor() {
      return isSignedIn() && (getUserRole() == 'supervisor' || isAdmin());
    }

    function isKasir() {
      return isSignedIn() && (getUserRole() == 'kasir' || isSupervisor());
    }

    // =========================================================================
    // SANTRIWATI (CARD IDENTITY, RFID, PIN, SALDO & LIMITS)
    // =========================================================================
    match /santriwati/{santriId} {
      // Read: All authenticated staff (Admin, Supervisor, Kasir) can read santri identity for POS
      allow read: if isSignedIn();

      // Create / Delete: Admin and Supervisor only (Kasir is read-only)
      allow create: if (isAdmin() || isSupervisor()) 
        && request.resource.data.nis is string 
        && request.resource.data.rfidUid is string
        && request.resource.data.balance >= 0
        && request.resource.data.dailyLimit >= 0;

      allow delete: if isAdmin() || isSupervisor();

      // Update: Admin/Supervisor full update; Kasir can only update balance & PIN lock during checkout
      allow update: if (isAdmin() || isSupervisor()) 
        || (isKasir() && request.resource.data.balance >= 0);
    }

    // =========================================================================
    // PRODUCTS & CATALOG
    // =========================================================================
    match /products/{productId} {
      allow read: if isSignedIn();

      // Kasir CANNOT alter prices, add or delete products
      allow create, delete: if isAdmin() || isSupervisor();

      // Update: Admin/Supervisor full update; Kasir can decrement stock during transactions
      allow update: if (isAdmin() || isSupervisor())
        || (isKasir() 
            && request.resource.data.sellingPrice == resource.data.sellingPrice 
            && request.resource.data.costPrice == resource.data.costPrice 
            && request.resource.data.stock >= 0);
    }

    // =========================================================================
    // CATEGORIES & SUPPLIERS
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSupervisor();
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSupervisor();
    }

    // =========================================================================
    // TRANSACTIONS (POS RFID CASHLESS SALES)
    // =========================================================================
    match /transactions/{trxId} {
      allow read: if isSignedIn();

      // Create: Valid cashier can create transactions with positive totals & non-empty items
      allow create: if isKasir() 
        && request.resource.data.totalAmount >= 0 
        && request.resource.data.santriBalanceAfter >= 0
        && request.resource.data.items.size() > 0;

      // Transactions are immutable historical financial records
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // TOP UPS (SALDO TOPUP & APPROVALS)
    // =========================================================================
    match /topups/{topupId} {
      allow read: if isSignedIn();

      // Create: Any authenticated staff can register a top-up request
      allow create: if isSignedIn() && request.resource.data.amount >= 1000;

      // Approval / Rejection: STRICTLY Admin only. Kasir and Supervisor are forbidden.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // INVENTORY (STOCK RECEIPTS & STOCK OPNAME)
    // =========================================================================
    match /stockReceipts/{receiptId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isSupervisor();
      allow delete: if isAdmin();
    }

    match /stockAdjustments/{adjustmentId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isSupervisor();
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // AUDIT LOGS (IMMUTABLE SECURITY & SYSTEM LOGS)
    // =========================================================================
    match /auditLogs/{logId} {
      // Read: Admin and Supervisor
      allow read: if isAdmin() || isSupervisor();

      // Create: All authenticated users write audit logs
      allow create: if isSignedIn() 
        && request.resource.data.action is string 
        && request.resource.data.details is string;

      // Audit logs are append-only and cannot be altered or deleted
      allow update, delete: if false;
    }

    // =========================================================================
    // USERS & ROLE MANAGEMENT
    // =========================================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      // Only Admin can create, modify, or delete user accounts
      allow write: if isAdmin();
    }

    // =========================================================================
    // SETTINGS (GLOBAL PESANTREN & PAYMENT CONFIGURATION)
    // =========================================================================
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
